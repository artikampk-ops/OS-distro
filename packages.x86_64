# The few apps every desktop needs. Brave, PhotoCraft and the Artika apps are
# not in Arch's repositories; build.sh packages those itself.
discord
dolphin
konsole
kwrite
ark
spectacle
gwenview
okular

# App store, for Linux apps from Flathub
discover
flatpak

# Windows programs run through Proton, which its launcher fetches on first use
python
bubblewrap

# Installer
rsync
gptfdisk
dosfstools
e2fsprogs
efibootmgr
arch-install-scripts
sudo
kdialog
